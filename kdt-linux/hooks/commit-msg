#!/usr/bin/env sh
# ===============================================================
# commit-msg hook — Conventional Commits format check
# ===============================================================
MSG_FILE="$1"
MSG=$(head -n 1 "$MSG_FILE")

case "$MSG" in
    Merge*|Revert*)
        exit 0
        ;;
esac

PATTERN="^(feat|fix|docs|style|refactor|test|chore|data|merge)(\([a-z0-9_-]+\))?: .{3,72}$"

if ! echo "$MSG" | grep -Eq "$PATTERN"; then
    echo "=============================================="
    echo " [ERROR] Invalid commit message format."
    echo "  Message: $MSG"
    echo ""
    echo "  Expected: <type>(<scope>): <subject>"
    echo "  Types   : feat | fix | docs | style | refactor | test | chore | data"
    echo "  Example : feat(check): add dataset validation logic"
    echo "=============================================="
    exit 1
fi
exit 0
